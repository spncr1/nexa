<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXA - Register</title>

    <!-- CSS stylesheet -->
    <link rel="stylesheet" href="/client/shared/styles/auth.css">

    <!-- Primary Font (Headers & Titles - Manrope) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">

    <!-- Secondary Font (Body Text - Noto Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/client/shared/assets/Images/nexa-logo.png">
</head>
<body>

    <main class="content">
        <% const formValues = typeof values !== 'undefined' ? values : {}; %>
        <% const fieldErrors = typeof errors !== 'undefined' ? errors : {}; %>
        <% const alertError = typeof formError !== 'undefined' ? formError : null; %>

        <img id="nexa-logo" src="/client/shared/assets/Images/nexa-logo.png">
        <h1>NEXA Register</h1>

        <% if (alertError) { %>
            <p class="auth-status error"><%= alertError %></p>
        <% } %>

        <form class="auth-form" action="/register" method="POST" novalidate>
            <div class="form-row <%= fieldErrors.name ? 'has-error' : '' %>">
                <label for="name">Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= formValues.name || '' %>"
                    autocomplete="name"
                    minlength="2"
                    maxlength="100"
                    required
                    aria-invalid="<%= fieldErrors.name ? 'true' : 'false' %>"
                    <%= fieldErrors.name ? 'aria-describedby="name-error"' : '' %>
                >
                <% if (fieldErrors.name) { %>
                    <p class="field-error" id="name-error"><%= fieldErrors.name %></p>
                <% } %>
            </div>

            <div class="form-row <%= fieldErrors.email ? 'has-error' : '' %>">
                <label for="email">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    value="<%= formValues.email || '' %>"
                    autocomplete="email"
                    required
                    aria-invalid="<%= fieldErrors.email ? 'true' : 'false' %>"
                    <%= fieldErrors.email ? 'aria-describedby="email-error"' : '' %>
                >
                <% if (fieldErrors.email) { %>
                    <p class="field-error" id="email-error"><%= fieldErrors.email %></p>
                <% } %>
            </div>

            <div class="form-row <%= fieldErrors.password ? 'has-error' : '' %>">
                <label for="password">Password</label>
                <div class="password-input-group">
                    <input
                        type="password"
                        id="password"
                        name="password"
                        autocomplete="new-password"
                        minlength="12"
                        maxlength="64"
                        required
                        aria-invalid="<%= fieldErrors.password ? 'true' : 'false' %>"
                        aria-describedby="<%= fieldErrors.password ? 'password-guidance password-error' : 'password-guidance' %>"
                    >
                    <button id="toggle-password-btn" class="password-inline-btn" type="button" aria-label="Show password" aria-pressed="false">
                        <img class="app-icon password-visibility-icon" src="/client/shared/assets/Icons/visibility-on.svg" alt="" aria-hidden="true">
                    </button>
                </div>
                <ul class="password-guidance" id="password-guidance">
                    <li>Use 12-64 characters</li>
                    <li>Include an uppercase letter, a number, and a symbol</li>
                    <li>Avoid common or easy-to-guess passwords</li>
                </ul>
                <% if (fieldErrors.password) { %>
                    <p class="field-error" id="password-error"><%= fieldErrors.password %></p>
                <% } %>
                <div class="password-suggestion">
                    <span>Use suggested password?</span>
                    <button id="generate-password-btn" class="generate-random-password-btn" type="button">Generate</button>
                </div>
            </div>

            <button type="submit">Register</button>
        </form>

        <p>Already have an account?</p>

        <a class="auth-link" href="/login">Login</a>
        <a class="auth-link secondary" href="/welcome">See what NEXA does</a>
    </main>

    <script src="/client/register-password.js"></script>
</body>
</html>
